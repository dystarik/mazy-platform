{
    "Serilog": {
        "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.Async", "Serilog.Sinks.Grafana.Loki", "Serilog.Enrichers.Environment", "Serilog.Enrichers.Thread" ],
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "Microsoft": "Warning",
                "System": "Warning"
            }
        },
        "Enrich": [ "FromLogContext", "WithEnvironmentName", "WithThreadId" ],
        "WriteTo": [
            {
                "Name": "Async",
                "Args": {
                    "configure": [
                        {
                            "Name": "Console",
                            "Args": {
                                "theme": "Serilog.Sinks.SystemConsole.Themes.AnsiConsoleTheme::Sixteen, Serilog.Sinks.Console",
                                "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Application} {Message:lj}{NewLine}{Exception}"
                            }
                        }
                    ]
                }
            },
            {
                "Name": "GrafanaLoki",
                "Args": {
                    "uri": "http://loki:3100",
                    "labels": [
                        {
                            "key": "app",
                            "value": "bot-integration"
                        }
                    ],
                    "filtrationMode": "WhiteList",
                    "filtrationLabels": [
                        "app",
                        "EnvironmentName",
                        "level"
                    ],
                    "batchPostingLimit": 1000,
                    "period": "0.00:00:02",
                    "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Application} {Message:lj}{NewLine}{Exception}"
                }
            }
        ],
        "Properties": {
            "Application": "bot-integration"
        }
    },
    "RabbitMq": {
        "Host": "localhost",
        "Port": 5672,
        "Username": "guest",
        "Password": "02bc512304acfbe2c8739809d5de563f367cd67ded4480df2a7e7ef287fbde7e",
        "VirtualHost": "/",
        "ExchangeName": "mazy.exchange",
        "ExchangeType": "topic",
        "DeadLetterExchangeName": "mazy.exchange.dlx",
        "Prefetch": 1,
        "Queues": [
            {
                "QueueName": "bot-integration.bot-activated",
                "RoutingKey": "bot.manager.bot-instance-activated",
                "DeadLetterQueueName": "bot-integration.bot-activated.dlx"
            },
            {
                "QueueName": "bot-integration.bot-deactivated",
                "RoutingKey": "bot.manager.bot-instance-deactivated",
                "DeadLetterQueueName": "bot-integration.bot-deactivated.dlx"
            },
            {
                "QueueName": "bot-integration.bot-deleted",
                "RoutingKey": "bot.manager.bot-instance-deleted",
                "DeadLetterQueueName": "bot-integration.bot-deleted.dlx"
            },
            {
                "QueueName": "bot-integration.bot-token-changed",
                "RoutingKey": "bot.manager.bot-instance-token-changed",
                "DeadLetterQueueName": "bot-integration.bot-token-changed.dlx"
            },
            {
                "QueueName": "bot-integration.bot-unbound",
                "RoutingKey": "bot.manager.bot-instance-unbound-from-project",
                "DeadLetterQueueName": "bot-integration.bot-unbound.dlx"
            }
        ]
    },
    "BotManager": {
        "Address": "http://localhost:7202",
        "AccessToken": "change-me"
    },
    "Vk": {
        "ApiVersion": "5.199",
        "WaitSeconds": 25
    },
    "Telegram": {
        "TimeoutSeconds": 30,
        "RetryDelaySeconds": 5
    }
}

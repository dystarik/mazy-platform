{
    "Serilog": {
        "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.Async", "Serilog.Sinks.Grafana.Loki", "Serilog.Enrichers.Environment", "Serilog.Enrichers.Thread" ],
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "Microsoft": "Warning",
                "System": "Warning",
                "Grpc": "Warning"
            }
        },
        "Enrich": [ "FromLogContext", "WithEnvironmentName", "WithThreadId" ],
        "WriteTo": [
            {
                "Name": "Async",
                "Args": {
                    "configure": [
                        {
                            "Name": "Console",
                            "Args": {
                                "theme": "Serilog.Sinks.SystemConsole.Themes.AnsiConsoleTheme::Sixteen, Serilog.Sinks.Console",
                                "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Application} {Message:lj}{NewLine}{Exception}"
                            }
                        }
                    ]
                }
            },
            {
                "Name": "GrafanaLoki",
                "Args": {
                    "uri": "http://loki:3100",
                    "labels": [
                        {
                            "key": "app",
                            "value": "notification"
                        }
                    ],
                    "filtrationMode": "WhiteList",
                    "filtrationLabels": [
                        "app",
                        "EnvironmentName",
                        "level"
                    ],
                    "batchPostingLimit": 1000,
                    "period": "0.00:00:02",
                    "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Application} {Message:lj}{NewLine}{Exception}"
                }
            }
        ],
        "Properties": {
            "Application": "notification"
        }
    },
    "RabbitMq": {
        "Host": "localhost",
        "Port": 5672,
        "Username": "REPLACE_ME",
        "Password": "REPLACE_ME",
        "VirtualHost": "/",
        "ExchangeName": "mazy.exchange",
        "ExchangeType": "topic",
        "Prefetch": 1,
        "RetryCount": 5,
        "RetryDelaySeconds": 5,
        "DeadLetterExchangeName": "mazy.exchange.dlx",
        "Queues": [
            {
                "QueueName": "notification.user",
                "RoutingKey": "user.#",
                "DeadLetterQueueName": "notification.user.dlx"
            }
        ]
    },
    "Email": {
        "Host": "postbox.cloud.yandex.net",
        "Port": 465,
        "Username": "REPLACE_ME",
        "Password": "REPLACE_ME",
        "From": "noreply@mazy-platform.ru",
        "DisplayName": "Mazy Platform"
    }
}

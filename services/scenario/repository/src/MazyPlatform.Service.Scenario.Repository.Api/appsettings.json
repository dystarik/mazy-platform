{
    "Kestrel": {
        "Endpoints": {
            "Public": {
                "Url": "http://+:6101",
                "Protocols": "Http2"
            },
            "Internal": {
                "Url": "http://+:6102",
                "Protocols": "Http2"
            }
        }
    },
    "InternalApi": {
        "AccessToken": "REPLACE_ME"
    },
    "Serilog": {
        "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.Async", "Serilog.Sinks.Grafana.Loki", "Serilog.Enrichers.Environment", "Serilog.Enrichers.Thread" ],
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "Microsoft": "Warning",
                "System": "Warning",
                "Grpc": "Warning"
            }
        },
        "Enrich": [ "FromLogContext", "WithEnvironmentName", "WithThreadId" ],
        "WriteTo": [
            {
                "Name": "Async",
                "Args": {
                    "configure": [
                        {
                            "Name": "Console",
                            "Args": {
                                "theme": "Serilog.Sinks.SystemConsole.Themes.AnsiConsoleTheme::Sixteen, Serilog.Sinks.Console",
                                "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Application} {Message:lj}{NewLine}{Exception}"
                            }
                        }
                    ]
                }
            },
            {
                "Name": "GrafanaLoki",
                "Args": {
                    "uri": "http://loki:3100",
                    "labels": [
                        {
                            "key": "app",
                            "value": "scenario-repository"
                        }
                    ],
                    "filtrationMode": "WhiteList",
                    "filtrationLabels": [
                        "app",
                        "EnvironmentName",
                        "level"
                    ],
                    "batchPostingLimit": 1000,
                    "period": "0.00:00:02",
                    "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Application} {Message:lj}{NewLine}{Exception}"
                }
            }
        ],
        "Properties": {
            "Application": "scenario-repository"
        }
    },
    "BotManager": {
        "Address": "REPLACE_ME",
        "AccessToken": "REPLACE_ME"
    },
    "ConnectionStrings": {
        "DefaultConnection": "REPLACE_ME"
    },
    "MongoDb": {
        "ConnectionString": "REPLACE_ME",
        "DatabaseName": "mazy_scenario"
    },
    "RabbitMq": {
        "Host": "REPLACE_ME",
        "Port": 5672,
        "Username": "REPLACE_ME",
        "Password": "REPLACE_ME",
        "VirtualHost": "/",
        "ExchangeName": "mazy.exchange",
        "ExchangeType": "topic",
        "DeadLetterExchangeName": "mazy.exchange.dead-letter",
        "Prefetch": 10,
        "Queues": [
            {
                "QueueName": "scenario-repository.user-account.email-confirmed",
                "RoutingKey": "user.authentication.email-confirmed",
                "DeadLetterQueueName": "scenario-repository.user-account.email-confirmed.dead-letter"
            }
        ]
    }
}

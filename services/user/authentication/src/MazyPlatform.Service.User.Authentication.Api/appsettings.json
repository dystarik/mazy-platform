{
    "Kestrel": {
        "EndpointDefaults": {
            "Protocols": "Http2"
        }
    },
    "Serilog": {
        "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.Async", "Serilog.Sinks.Grafana.Loki", "Serilog.Enrichers.Environment", "Serilog.Enrichers.Thread" ],
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "Microsoft": "Warning",
                "System": "Warning",
                "Grpc": "Warning"
            }
        },
        "Enrich": [ "FromLogContext", "WithEnvironmentName", "WithThreadId" ],
        "WriteTo": [
            {
                "Name": "Async",
                "Args": {
                    "configure": [
                        {
                            "Name": "Console",
                            "Args": {
                                "theme": "Serilog.Sinks.SystemConsole.Themes.AnsiConsoleTheme::Sixteen, Serilog.Sinks.Console",
                                "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Application} {Message:lj}{NewLine}{Exception}"
                            }
                        }
                    ]
                }
            },
            {
                "Name": "GrafanaLoki",
                "Args": {
                    "uri": "http://loki:3100",
                    "labels": [
                        {
                            "key": "app",
                            "value": "user-authentication"
                        }
                    ],
                    "filtrationMode": "WhiteList",
                    "filtrationLabels": [
                        "app",
                        "EnvironmentName",
                        "level"
                    ],
                    "batchPostingLimit": 1000,
                    "period": "0.00:00:02",
                    "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Application} {Message:lj}{NewLine}{Exception}"
                }
            }
        ],
        "Properties": {
            "Application": "user-authentication"
        }
    },
    "ConnectionStrings": {
        "DefaultConnection": "REPLACE_ME"
    },
    "Jwt": {
        "ExpirationMinutes": 15,
        "Issuer": "MazyPlatform",
        "Audience": "MazyPlatform.Clients",
        "SecretKey": "REPLACE_ME"
    },
    "RabbitMq": {
        "Host": "REPLACE_ME",
        "Port": 5672,
        "Username": "REPLACE_ME",
        "Password": "REPLACE_ME",
        "VirtualHost": "/",
        "ExchangeName": "mazy.exchange"
    },
    "TotpEncryption": {
        "Key": "REPLACE_ME"
    },
    "Totp": {
        "Issuer": "MazyPlatform",
        "VerificationWindowPastSteps": 1,
        "VerificationWindowFutureSteps": 0
    },
    "ExternalProviders": {
        "Yandex": {
            "ClientId": "REPLACE_ME",
            "ClientSecret": "REPLACE_ME",
            "RedirectUri": "REPLACE_ME"
        }
    }
}

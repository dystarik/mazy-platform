apps/web-client/**/*.sass text eol=lf
apps/web-client/**/*.less text eol=lf
apps/web-client/**/*.styl text eol=lf
apps/web-client/**/*.json text eol=lf
apps/web-client/**/*.md text eol=lf
apps/web-client/**/*.html text eol=lf

# Unix scripts / containers
*.sh text eol=lf
Dockerfile text eol=lf

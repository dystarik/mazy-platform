{
    "AllowedHosts": "*",
    "Cors": {
        "AllowedOrigins": [ "https://mazy-platform.ru" ]
    },
    "Services": {
        "Authentication": "http://authentication:8081",
        "ScenarioRepository": "http://scenario-repository:8083",
        "BotManager": "http://bot-manager:8082"
    },
    "Jwt": {
        "Issuer": "MazyPlatform",
        "Audience": "MazyPlatform.Clients",
        "SecretKey": "REPLACE_ME"
    },
    "Serilog": {
        "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.Async", "Serilog.Sinks.Grafana.Loki", "Serilog.Enrichers.Environment", "Serilog.Enrichers.Thread" ],
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "Microsoft": "Warning",
                "System": "Warning",
                "Grpc": "Warning"
            }
        },
        "Enrich": [ "FromLogContext", "WithEnvironmentName", "WithThreadId" ],
        "WriteTo": [
            {
                "Name": "Async",
                "Args": {
                    "configure": [
                        {
                            "Name": "Console",
                            "Args": {
                                "theme": "Serilog.Sinks.SystemConsole.Themes.AnsiConsoleTheme::Sixteen, Serilog.Sinks.Console",
                                "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Application} {Message:lj}{NewLine}{Exception}"
                            }
                        }
                    ]
                }
            },
            {
                "Name": "GrafanaLoki",
                "Args": {
                    "uri": "http://loki:3100",
                    "labels": [
                        {
                            "key": "app",
                            "value": "gateway"
                        }
                    ],
                    "filtrationMode": "WhiteList",
                    "filtrationLabels": [
                        "app",
                        "EnvironmentName",
                        "level"
                    ],
                    "batchPostingLimit": 1000,
                    "period": "0.00:00:02",
                    "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Application} {Message:lj}{NewLine}{Exception}"
                }
            }
        ],
        "Properties": {
            "Application": "gateway"
        }
    }
}

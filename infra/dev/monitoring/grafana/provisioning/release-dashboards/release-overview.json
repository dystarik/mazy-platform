{
  "title": "Release Overview",
  "uid": "mazy-release-overview",
  "tags": [ "release" ],
  "schemaVersion": 42,
  "refresh": "10s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "HTTP готовность",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus-mazy" },
      "fieldConfig": { "defaults": { "unit": "short", "mappings": [ { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } } ], "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": 0 }, { "color": "green", "value": 1 } ] } } },
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "center", "orientation": "auto", "reduceOptions": { "calcs": [ "lastNotNull" ], "fields": "", "values": false }, "textMode": "auto", "wideLayout": true },
      "targets": [ { "expr": "min(probe_success{job=\"blackbox-health-ready\"})", "refId": "A" } ]
    },
    {
      "id": 2,
      "title": "gRPC порты",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus-mazy" },
      "fieldConfig": { "defaults": { "mappings": [ { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } } ], "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": 0 }, { "color": "green", "value": 1 } ] } } },
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "center", "orientation": "auto", "reduceOptions": { "calcs": [ "lastNotNull" ], "fields": "", "values": false }, "textMode": "auto", "wideLayout": true },
      "targets": [ { "expr": "min(probe_success{job=\"blackbox-grpc-tcp\"})", "refId": "A" } ]
    },
    {
      "id": 3,
      "title": "Инфраструктура",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus-mazy" },
      "fieldConfig": { "defaults": { "mappings": [ { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } } ], "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": 0 }, { "color": "green", "value": 1 } ] } } },
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "center", "orientation": "auto", "reduceOptions": { "calcs": [ "lastNotNull" ], "fields": "", "values": false }, "textMode": "auto", "wideLayout": true },
      "targets": [ { "expr": "min(mazy_container_up{job=\"docker-stats-exporter\",service=~\"postgres|mongodb|rabbitmq|loki|prometheus|grafana|blackbox-exporter|docker-stats-exporter\"})", "refId": "A" } ]
    },
    {
      "id": 4,
      "title": "Gateway ошибки",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus-mazy" },
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": 0 }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 10 } ] } } },
      "options": { "colorMode": "background", "graphMode": "area", "justifyMode": "center", "orientation": "auto", "reduceOptions": { "calcs": [ "lastNotNull" ], "fields": "", "values": false }, "textMode": "value", "wideLayout": true },
      "targets": [ { "expr": "sum(increase(microsoft_aspnetcore_hosting_failed_requests{job=\"gateway\"}[$__range]))", "refId": "A" } ]
    },
    {
      "id": 5,
      "title": "Очереди",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus-mazy" },
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": 0 }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 100 } ] } } },
      "options": { "colorMode": "background", "graphMode": "area", "justifyMode": "center", "orientation": "auto", "reduceOptions": { "calcs": [ "lastNotNull" ], "fields": "", "values": false }, "textMode": "value", "wideLayout": true },
      "targets": [ { "expr": "sum(rabbitmq_queue_messages{job=\"rabbitmq-per-object\"})", "refId": "A" } ]
    },
    {
      "id": 6,
      "title": "Ошибки в логах",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 0 },
      "datasource": { "type": "loki", "uid": "loki-mazy" },
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": 0 }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 10 } ] } } },
      "options": { "colorMode": "background", "graphMode": "area", "justifyMode": "center", "orientation": "auto", "reduceOptions": { "calcs": [ "lastNotNull" ], "fields": "", "values": false }, "textMode": "value", "wideLayout": true },
      "targets": [ { "expr": "sum(count_over_time({app=~\".+\"} | json | level=~\"(?i)(error|fatal|critical|err|ftl)\" [$__range]))", "refId": "A" } ]
    },
    {
      "id": 7,
      "title": "Задержка Gateway",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus-mazy" },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 2, "pointSize": 3, "showPoints": "never" } } },
      "options": { "legend": { "showLegend": true, "displayMode": "table", "placement": "bottom", "calcs": [ "lastNotNull", "max" ] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum by (le) (rate(microsoft_aspnetcore_hosting_http_server_request_duration_bucket{job=\"gateway\"}[5m])))", "legendFormat": "p50", "refId": "A" },
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(microsoft_aspnetcore_hosting_http_server_request_duration_bucket{job=\"gateway\"}[5m])))", "legendFormat": "p95", "refId": "B" },
        { "expr": "histogram_quantile(0.99, sum by (le) (rate(microsoft_aspnetcore_hosting_http_server_request_duration_bucket{job=\"gateway\"}[5m])))", "legendFormat": "p99", "refId": "C" }
      ]
    },
    {
      "id": 8,
      "title": "Состояние сервисов",
      "type": "state-timeline",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus-mazy" },
      "fieldConfig": { "defaults": { "mappings": [ { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } } ], "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": 0 }, { "color": "green", "value": 1 } ] } } },
      "options": { "legend": { "showLegend": true, "displayMode": "list", "placement": "bottom" }, "mergeValues": true, "showValue": "always", "tooltip": { "mode": "multi", "sort": "none" } },
      "targets": [
        { "expr": "probe_success{job=\"blackbox-health-ready\"}", "legendFormat": "{{service}} ready", "refId": "A" },
        { "expr": "probe_success{job=\"blackbox-grpc-tcp\"}", "legendFormat": "{{service}} {{endpoint}}", "refId": "B" }
      ]
    },
    {
      "id": 9,
      "title": "Ошибки и предупреждения",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "datasource": { "type": "loki", "uid": "loki-mazy" },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "bars", "lineInterpolation": "linear", "lineWidth": 1, "pointSize": 3, "showPoints": "never" } } },
      "options": { "legend": { "showLegend": true, "displayMode": "table", "placement": "bottom", "calcs": [ "lastNotNull" ] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "expr": "sum by (app) (count_over_time({app=~\".+\"} | json | level=~\"(?i)(error|fatal|critical|err|ftl)\" [$__interval]))", "legendFormat": "{{app}} errors", "refId": "A" },
        { "expr": "sum by (app) (count_over_time({app=~\".+\"} | json | level=~\"(?i)(warn|warning|wrn)\" [$__interval]))", "legendFormat": "{{app}} warnings", "refId": "B" }
      ]
    },
    {
      "id": 10,
      "title": "Память контейнеров",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus-mazy" },
      "fieldConfig": { "defaults": { "unit": "mbytes", "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 2, "pointSize": 3, "showPoints": "never" } } },
      "options": { "legend": { "showLegend": true, "displayMode": "table", "placement": "bottom", "calcs": [ "lastNotNull", "max" ] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [ { "expr": "topk(12, sum by(service) (mazy_container_memory_working_set_bytes{job=\"docker-stats-exporter\"}) / 1024 / 1024)", "legendFormat": "{{service}}", "refId": "A" } ]
    }
  ]
}

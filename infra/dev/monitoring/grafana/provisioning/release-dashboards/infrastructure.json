    {
      "id": 4,
      "title": "Loki",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus-mazy" },
      "fieldConfig": { "defaults": { "mappings": [ { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } } ], "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": 0 }, { "color": "green", "value": 1 } ] } } },
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "center", "orientation": "auto", "reduceOptions": { "calcs": [ "lastNotNull" ], "fields": "", "values": false }, "textMode": "auto", "wideLayout": true },
      "targets": [ { "expr": "max(mazy_container_up{job=\"docker-stats-exporter\",service=\"loki\"})", "refId": "A" } ]
    },
    {
      "id": 5,
      "title": "Prometheus",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus-mazy" },
      "fieldConfig": { "defaults": { "mappings": [ { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } } ], "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": 0 }, { "color": "green", "value": 1 } ] } } },
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "center", "orientation": "auto", "reduceOptions": { "calcs": [ "lastNotNull" ], "fields": "", "values": false }, "textMode": "auto", "wideLayout": true },
      "targets": [ { "expr": "max(mazy_container_up{job=\"docker-stats-exporter\",service=\"prometheus\"})", "refId": "A" } ]
    },
    {
      "id": 6,
      "title": "Grafana",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus-mazy" },
      "fieldConfig": { "defaults": { "mappings": [ { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } } ], "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": 0 }, { "color": "green", "value": 1 } ] } } },
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "center", "orientation": "auto", "reduceOptions": { "calcs": [ "lastNotNull" ], "fields": "", "values": false }, "textMode": "auto", "wideLayout": true },
      "targets": [ { "expr": "max(mazy_container_up{job=\"docker-stats-exporter\",service=\"grafana\"})", "refId": "A" } ]
    },
    {
      "id": 7,
      "title": "Недоступные контейнеры",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus-mazy" },
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": 0 }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 3 } ] } } },
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "center", "orientation": "auto", "reduceOptions": { "calcs": [ "lastNotNull" ], "fields": "", "values": false }, "textMode": "value", "wideLayout": true },
      "targets": [ { "expr": "sum(1 - mazy_container_up{job=\"docker-stats-exporter\",service=~\"postgres|mongodb|rabbitmq|loki|prometheus|grafana|blackbox-exporter|docker-stats-exporter\"})", "refId": "A" } ]
    },
    {
      "id": 8,
      "title": "Память инфраструктуры",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus-mazy" },
      "fieldConfig": { "defaults": { "unit": "mbytes", "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": 0 }, { "color": "yellow", "value": 1024 }, { "color": "red", "value": 2048 } ] } } },
      "options": { "colorMode": "background", "graphMode": "area", "justifyMode": "center", "orientation": "auto", "reduceOptions": { "calcs": [ "lastNotNull" ], "fields": "", "values": false }, "textMode": "value", "wideLayout": true },
      "targets": [ { "expr": "sum(mazy_container_memory_working_set_bytes{job=\"docker-stats-exporter\",service=~\"postgres|mongodb|rabbitmq|loki|prometheus|grafana|blackbox-exporter|docker-stats-exporter\"}) / 1024 / 1024", "refId": "A" } ]
    },
    {
      "id": 9,
      "title": "Состояние контейнеров",
      "type": "state-timeline",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus-mazy" },
      "fieldConfig": { "defaults": { "mappings": [ { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } } ], "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": 0 }, { "color": "green", "value": 1 } ] } } },
      "options": { "legend": { "showLegend": true, "displayMode": "list", "placement": "bottom" }, "mergeValues": true, "showValue": "always", "tooltip": { "mode": "multi", "sort": "none" } },
      "targets": [ { "expr": "mazy_container_up{job=\"docker-stats-exporter\",service=~\"postgres|mongodb|rabbitmq|loki|prometheus|grafana|blackbox-exporter|docker-stats-exporter\"}", "legendFormat": "{{service}}", "refId": "A" } ]
    },
    {
      "id": 10,
      "title": "Память по контейнерам",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus-mazy" },
      "fieldConfig": { "defaults": { "unit": "mbytes", "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 2, "pointSize": 3, "showPoints": "never" } } },
      "options": { "legend": { "showLegend": true, "displayMode": "table", "placement": "bottom", "calcs": [ "lastNotNull", "max" ] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [ { "expr": "sum by(service) (mazy_container_memory_working_set_bytes{job=\"docker-stats-exporter\",service=~\"postgres|mongodb|rabbitmq|loki|prometheus|grafana|blackbox-exporter|docker-stats-exporter\"}) / 1024 / 1024", "legendFormat": "{{service}}", "refId": "A" } ]
    },
    {
      "id": 11,
      "title": "Самые тяжелые контейнеры",
      "type": "bargauge",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus-mazy" },
      "fieldConfig": { "defaults": { "unit": "mbytes", "min": 0, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": 0 }, { "color": "yellow", "value": 512 }, { "color": "red", "value": 1024 } ] } } },
      "options": { "displayMode": "gradient", "maxVizHeight": 300, "minVizHeight": 16, "minVizWidth": 8, "namePlacement": "auto", "orientation": "horizontal", "reduceOptions": { "calcs": [ "lastNotNull" ], "fields": "", "values": false }, "showUnfilled": true, "sizing": "auto", "valueMode": "color" },
      "targets": [ { "expr": "sort_desc(sum by(service) (mazy_container_memory_working_set_bytes{job=\"docker-stats-exporter\"}) / 1024 / 1024)", "legendFormat": "{{service}}", "refId": "A" } ]
    }
  ]
}

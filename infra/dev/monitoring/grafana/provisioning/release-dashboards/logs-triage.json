{
  "title": "Logs Triage",
  "uid": "mazy-release-logs-triage",
  "tags": [ "release" ],
  "schemaVersion": 42,
  "refresh": "10s",
  "time": { "from": "now-15m", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "app",
        "type": "query",
        "datasource": { "type": "loki", "uid": "loki-mazy" },
        "query": "label_values(app)",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": { "selected": true, "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Ошибки",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "loki", "uid": "loki-mazy" },
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": 0 }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 10 } ] } } },
      "options": { "colorMode": "background", "graphMode": "area", "justifyMode": "center", "orientation": "auto", "reduceOptions": { "calcs": [ "lastNotNull" ], "fields": "", "values": false }, "textMode": "value", "wideLayout": true },
      "targets": [ { "expr": "sum(count_over_time({app=~\"${app:regex}\"} | json | level=~\"(?i)(error|fatal|critical|err|ftl)\" [$__range]))", "refId": "A" } ]
    },
    {
      "id": 2,
      "title": "Предупреждения",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "loki", "uid": "loki-mazy" },
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": 0 }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 20 } ] } } },
      "options": { "colorMode": "background", "graphMode": "area", "justifyMode": "center", "orientation": "auto", "reduceOptions": { "calcs": [ "lastNotNull" ], "fields": "", "values": false }, "textMode": "value", "wideLayout": true },
      "targets": [ { "expr": "sum(count_over_time({app=~\"${app:regex}\"} | json | level=~\"(?i)(warn|warning|wrn)\" [$__range]))", "refId": "A" } ]
    },
    {
      "id": 3,
      "title": "Приложения с ошибками",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "loki", "uid": "loki-mazy" },
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": 0 }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 3 } ] } } },
      "options": { "colorMode": "background", "graphMode": "area", "justifyMode": "center", "orientation": "auto", "reduceOptions": { "calcs": [ "lastNotNull" ], "fields": "", "values": false }, "textMode": "value", "wideLayout": true },
      "targets": [ { "expr": "count(count_over_time({app=~\"${app:regex}\"} | json | level=~\"(?i)(error|fatal|critical|err|ftl)\" [$__range]) > 0)", "refId": "A" } ]
    },
    {
      "id": 4,
      "title": "Логи в минуту",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "loki", "uid": "loki-mazy" },
      "fieldConfig": { "defaults": { "unit": "ops", "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": 0 }, { "color": "yellow", "value": 100 }, { "color": "red", "value": 500 } ] } } },
      "options": { "colorMode": "background", "graphMode": "area", "justifyMode": "center", "orientation": "auto", "reduceOptions": { "calcs": [ "lastNotNull" ], "fields": "", "values": false }, "textMode": "value", "wideLayout": true },
      "targets": [ { "expr": "sum(rate({app=~\"${app:regex}\"}[$__rate_interval])) * 60", "refId": "A" } ]
    },
    {
      "id": 5,
      "title": "Ошибки и предупреждения",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "loki", "uid": "loki-mazy" },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "bars", "lineInterpolation": "linear", "lineWidth": 1, "pointSize": 3, "showPoints": "never" } } },
      "options": { "legend": { "showLegend": true, "displayMode": "table", "placement": "bottom", "calcs": [ "lastNotNull" ] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "expr": "sum by (app) (count_over_time({app=~\"${app:regex}\"} | json | level=~\"(?i)(error|fatal|critical|err|ftl)\" [$__interval]))", "legendFormat": "{{app}} errors", "refId": "A" },
        { "expr": "sum by (app) (count_over_time({app=~\"${app:regex}\"} | json | level=~\"(?i)(warn|warning|wrn)\" [$__interval]))", "legendFormat": "{{app}} warnings", "refId": "B" }
      ]
    },
    {
      "id": 6,
      "title": "Топ приложений по ошибкам",
      "type": "bargauge",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "loki", "uid": "loki-mazy" },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": 0 }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 10 } ] } } },
      "options": { "displayMode": "gradient", "maxVizHeight": 300, "minVizHeight": 16, "minVizWidth": 8, "namePlacement": "auto", "orientation": "horizontal", "reduceOptions": { "calcs": [ "lastNotNull" ], "fields": "", "values": false }, "showUnfilled": true, "sizing": "auto", "valueMode": "color" },
      "targets": [ { "expr": "topk(10, sum by (app) (count_over_time({app=~\"${app:regex}\"} | json | level=~\"(?i)(error|fatal|critical|err|ftl)\" [$__range])))", "legendFormat": "{{app}}", "refId": "A" } ]
    },
    {
      "id": 7,
      "title": "Свежие ошибки",
      "type": "logs",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 12 },
      "datasource": { "type": "loki", "uid": "loki-mazy" },
      "options": { "dedupStrategy": "none", "enableLogDetails": true, "prettifyLogMessage": true, "showCommonLabels": false, "showLabels": true, "showTime": true, "sortOrder": "Descending", "wrapLogMessage": false },
      "targets": [ { "expr": "{app=~\"${app:regex}\"} | json | level=~\"(?i)(error|fatal|critical|err|ftl)\"", "refId": "A" } ]
    },
    {
      "id": 8,
      "title": "Свежие предупреждения",
      "type": "logs",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 22 },
      "datasource": { "type": "loki", "uid": "loki-mazy" },
      "options": { "dedupStrategy": "none", "enableLogDetails": true, "prettifyLogMessage": true, "showCommonLabels": false, "showLabels": true, "showTime": true, "sortOrder": "Descending", "wrapLogMessage": false },
      "targets": [ { "expr": "{app=~\"${app:regex}\"} | json | level=~\"(?i)(warn|warning|wrn)\"", "refId": "A" } ]
    }
  ]
}

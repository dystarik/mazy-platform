{
  "title": "Gateway",
  "uid": "mazy-release-gateway",
  "tags": [ "release" ],
  "schemaVersion": 42,
  "refresh": "10s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Запросы в секунду",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus-mazy" },
      "fieldConfig": { "defaults": { "unit": "reqps", "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": 0 }, { "color": "yellow", "value": 50 }, { "color": "red", "value": 200 } ] } } },
      "options": { "colorMode": "background", "graphMode": "area", "justifyMode": "center", "orientation": "auto", "reduceOptions": { "calcs": [ "lastNotNull" ], "fields": "", "values": false }, "textMode": "value", "wideLayout": true },
      "targets": [ { "expr": "sum(rate(microsoft_aspnetcore_hosting_requests_per_second_total{job=\"gateway\"}[1m]))", "refId": "A" } ]
    },
    {
      "id": 2,
      "title": "Активные запросы",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus-mazy" },
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": 0 }, { "color": "yellow", "value": 20 }, { "color": "red", "value": 100 } ] } } },
      "options": { "colorMode": "background", "graphMode": "area", "justifyMode": "center", "orientation": "auto", "reduceOptions": { "calcs": [ "lastNotNull" ], "fields": "", "values": false }, "textMode": "value", "wideLayout": true },
      "targets": [ { "expr": "sum(microsoft_aspnetcore_hosting_current_requests{job=\"gateway\"})", "refId": "A" } ]
    },
    {
      "id": 3,
      "title": "Ошибки в секунду",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus-mazy" },
      "fieldConfig": { "defaults": { "unit": "ops", "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": 0 }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 5 } ] } } },
      "options": { "colorMode": "background", "graphMode": "area", "justifyMode": "center", "orientation": "auto", "reduceOptions": { "calcs": [ "lastNotNull" ], "fields": "", "values": false }, "textMode": "value", "wideLayout": true },
      "targets": [ { "expr": "sum(rate(microsoft_aspnetcore_hosting_failed_requests{job=\"gateway\"}[1m]))", "refId": "A" } ]
    },
    {
      "id": 4,
      "title": "P95 задержка",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus-mazy" },
      "fieldConfig": { "defaults": { "unit": "s", "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": 0 }, { "color": "yellow", "value": 0.5 }, { "color": "red", "value": 1.5 } ] } } },
      "options": { "colorMode": "background", "graphMode": "area", "justifyMode": "center", "orientation": "auto", "reduceOptions": { "calcs": [ "lastNotNull" ], "fields": "", "values": false }, "textMode": "value", "wideLayout": true },
      "targets": [ { "expr": "histogram_quantile(0.95, sum by (le) (rate(microsoft_aspnetcore_hosting_http_server_request_duration_bucket{job=\"gateway\"}[5m])))", "refId": "A" } ]
    },
    {
      "id": 5,
      "title": "Запросы и ошибки",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus-mazy" },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 2, "pointSize": 3, "showPoints": "never" } } },
      "options": { "legend": { "showLegend": true, "displayMode": "table", "placement": "bottom", "calcs": [ "lastNotNull", "max" ] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "expr": "sum(rate(microsoft_aspnetcore_hosting_requests_per_second_total{job=\"gateway\"}[1m]))", "legendFormat": "requests", "refId": "A" },
        { "expr": "sum(rate(microsoft_aspnetcore_hosting_failed_requests{job=\"gateway\"}[1m]))", "legendFormat": "errors", "refId": "B" }
      ]
    },
    {
      "id": 6,
      "title": "Задержка запросов",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus-mazy" },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 2, "pointSize": 3, "showPoints": "never" } } },
      "options": { "legend": { "showLegend": true, "displayMode": "table", "placement": "bottom", "calcs": [ "lastNotNull", "max" ] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum by (le) (rate(microsoft_aspnetcore_hosting_http_server_request_duration_bucket{job=\"gateway\"}[5m])))", "legendFormat": "p50", "refId": "A" },
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(microsoft_aspnetcore_hosting_http_server_request_duration_bucket{job=\"gateway\"}[5m])))", "legendFormat": "p95", "refId": "B" },
        { "expr": "histogram_quantile(0.99, sum by (le) (rate(microsoft_aspnetcore_hosting_http_server_request_duration_bucket{job=\"gateway\"}[5m])))", "legendFormat": "p99", "refId": "C" }
      ]
    },
    {
      "id": 7,
      "title": "Самые активные маршруты",
      "type": "bargauge",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus-mazy" },
      "fieldConfig": { "defaults": { "unit": "reqps", "min": 0, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": 0 }, { "color": "yellow", "value": 50 }, { "color": "red", "value": 200 } ] } } },
      "options": { "displayMode": "gradient", "maxVizHeight": 300, "minVizHeight": 16, "minVizWidth": 8, "namePlacement": "auto", "orientation": "horizontal", "reduceOptions": { "calcs": [ "lastNotNull" ], "fields": "", "values": false }, "showUnfilled": true, "sizing": "auto", "valueMode": "color" },
      "targets": [ { "expr": "topk(10, sum by (http_request_method, http_route) (rate(microsoft_aspnetcore_hosting_http_server_request_duration_count{job=\"gateway\",http_route!=\"\"}[1m])))", "legendFormat": "{{http_request_method}} {{http_route}}", "refId": "A" } ]
    },
    {
      "id": 8,
      "title": "Готовность Gateway",
      "type": "state-timeline",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus-mazy" },
      "fieldConfig": { "defaults": { "mappings": [ { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } } ], "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": 0 }, { "color": "green", "value": 1 } ] } } },
      "options": { "legend": { "showLegend": true, "displayMode": "list", "placement": "bottom" }, "mergeValues": true, "showValue": "always", "tooltip": { "mode": "multi", "sort": "none" } },
      "targets": [
        { "expr": "probe_success{job=\"blackbox-health-live\",service=\"gateway\"}", "legendFormat": "live", "refId": "A" },
        { "expr": "probe_success{job=\"blackbox-health-ready\",service=\"gateway\"}", "legendFormat": "ready", "refId": "B" }
      ]
    }
  ]
}

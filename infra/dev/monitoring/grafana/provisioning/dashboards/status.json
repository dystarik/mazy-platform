      "type": "stat",
      "gridPos": { "h": 4, "w": 8, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus-mazy" },
      "fieldConfig": { "defaults": { "mappings": [ { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } } ], "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": 0 }, { "color": "green", "value": 1 } ] } } },
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "center", "orientation": "auto", "reduceOptions": { "calcs": [ "lastNotNull" ], "fields": "", "values": false }, "textMode": "value", "wideLayout": true },
      "targets": [ { "expr": "up{job=\"bot-manager\"}", "legendFormat": "bot-manager", "refId": "A" } ]
    },
    {
      "id": 6,
      "title": "scenario-engine",
      "type": "stat",
      "gridPos": { "h": 4, "w": 8, "x": 8, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus-mazy" },
      "fieldConfig": { "defaults": { "mappings": [ { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } } ], "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": 0 }, { "color": "green", "value": 1 } ] } } },
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "center", "orientation": "auto", "reduceOptions": { "calcs": [ "lastNotNull" ], "fields": "", "values": false }, "textMode": "value", "wideLayout": true },
      "targets": [ { "expr": "up{job=\"scenario-engine\"}", "legendFormat": "scenario-engine", "refId": "A" } ]
    },
    {
      "id": 7,
      "title": "bot-integration",
      "type": "stat",
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus-mazy" },
      "fieldConfig": { "defaults": { "mappings": [ { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } } ], "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": 0 }, { "color": "green", "value": 1 } ] } } },
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "center", "orientation": "auto", "reduceOptions": { "calcs": [ "lastNotNull" ], "fields": "", "values": false }, "textMode": "value", "wideLayout": true },
      "targets": [ { "expr": "up{job=\"bot-integration\"}", "legendFormat": "bot-integration", "refId": "A" } ]
    },
    {
      "id": 8,
      "title": "Память .NET backend — всего (MB)",
      "description": "Только working set backend .NET-сервисов: authentication, notification, gateway, scenario-repository, bot-manager, scenario-engine, bot-integration. БД, RabbitMQ, Loki, Prometheus и Grafana здесь не считаются.",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus-mazy" },
      "fieldConfig": { "defaults": { "unit": "decmbytes", "min": 0, "max": 2048, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": 0 }, { "color": "yellow", "value": 1024 }, { "color": "red", "value": 1600 } ] } } },
      "targets": [ { "expr": "sum(system_runtime_dotnet_process_memory_working_set{job=~\"authentication|notification|gateway|scenario-repository|bot-manager|scenario-engine|bot-integration\"}) / 1024 / 1024", "legendFormat": ".NET backend", "refId": "A" } ]
    },
    {
      "id": 9,
      "title": "CPU — среднее (%)",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus-mazy" },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": 0 }, { "color": "yellow", "value": 60 }, { "color": "red", "value": 85 } ] } } },
      "targets": [ { "expr": "avg(rate(system_runtime_dotnet_process_cpu_time{job=~\"authentication|notification|gateway|scenario-repository|bot-manager|scenario-engine|bot-integration\"}[1m])) * 100", "legendFormat": "Среднее", "refId": "A" } ]
    },
    {
      "id": 10,
      "title": "Память по сервисам (MB)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus-mazy" },
      "fieldConfig": { "defaults": { "unit": "decmbytes", "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 2, "pointSize": 3, "showPoints": "never" } } },
      "options": { "legend": { "showLegend": true, "displayMode": "table", "placement": "bottom", "calcs": [ "lastNotNull" ] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [ { "expr": "avg by(job) (system_runtime_dotnet_process_memory_working_set{job=~\"authentication|notification|gateway|scenario-repository|bot-manager|scenario-engine|bot-integration\"}) / 1024 / 1024", "legendFormat": "{{job}}", "refId": "A" } ]
    },
    {
      "id": 11,
      "title": "CPU по сервисам (%)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus-mazy" },
      "fieldConfig": { "defaults": { "unit": "percent", "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 2, "pointSize": 3, "showPoints": "never" } } },
      "options": { "legend": { "showLegend": true, "displayMode": "table", "placement": "bottom", "calcs": [ "lastNotNull" ] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [ { "expr": "avg by(job) (rate(system_runtime_dotnet_process_cpu_time{job=~\"authentication|notification|gateway|scenario-repository|bot-manager|scenario-engine|bot-integration\"}[1m])) * 100", "legendFormat": "{{job}}", "refId": "A" } ]
    },
    {
      "id": 12,
      "title": "Память контейнеров — всего (MB)",
      "description": "Считает все контейнеры dev compose через Docker stats exporter: backend, Postgres, MongoDB, RabbitMQ, Loki, Prometheus и Grafana.",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus-mazy" },
      "fieldConfig": { "defaults": { "unit": "decmbytes", "min": 0, "max": 4096, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": 0 }, { "color": "yellow", "value": 2048 }, { "color": "red", "value": 3072 } ] } } },
      "targets": [ { "expr": "sum(mazy_container_memory_working_set_bytes{job=\"docker-stats-exporter\"}) / 1024 / 1024", "legendFormat": "Все контейнеры", "refId": "A" } ]
    },
    {
      "id": 13,
      "title": "Память по контейнерам (MB)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus-mazy" },
      "fieldConfig": { "defaults": { "unit": "decmbytes", "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 2, "pointSize": 3, "showPoints": "never" } } },
      "options": { "legend": { "showLegend": true, "displayMode": "table", "placement": "bottom", "calcs": [ "lastNotNull" ] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [ { "expr": "sum by(service) (mazy_container_memory_working_set_bytes{job=\"docker-stats-exporter\"}) / 1024 / 1024", "legendFormat": "{{service}}", "refId": "A" } ]
    }
  ]

{
  "title": "Gateway",
  "uid": "mazy-gateway",
  "schemaVersion": 42,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Запросов в секунду",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus-mazy" },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "targets": [
        { "expr": "rate(microsoft_aspnetcore_hosting_requests_per_second_total{job=\"gateway\"}[1m])", "legendFormat": "запросов/с", "refId": "A" }
      ]
    },
    {
      "id": 2,
      "title": "Активные запросы",
      "type": "stat",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus-mazy" },
      "targets": [
        { "expr": "microsoft_aspnetcore_hosting_current_requests{job=\"gateway\"}", "legendFormat": "активные", "refId": "A" }
      ]
    },
    {
      "id": 3,
      "title": "Ошибки",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus-mazy" },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "fixedColor": "red", "mode": "fixed" } } },
      "targets": [
        { "expr": "rate(microsoft_aspnetcore_hosting_failed_requests{job=\"gateway\"}[1m])", "legendFormat": "ошибок/с", "refId": "A" }
      ]
    },
    {
      "id": 4,
      "title": "Латентность p50 / p95 / p99 (с)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus-mazy" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "pointSize": 3,
            "showPoints": "never"
          }
        }
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "right"
        },
        "tooltip": {
          "mode": "single",
          "sort": "desc"
        }
      },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum by (le) (rate(microsoft_aspnetcore_hosting_http_server_request_duration_bucket{job=\"gateway\"}[1m])))", "legendFormat": "p50", "refId": "A" },
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(microsoft_aspnetcore_hosting_http_server_request_duration_bucket{job=\"gateway\"}[1m])))", "legendFormat": "p95", "refId": "B" },
        { "expr": "histogram_quantile(0.99, sum by (le) (rate(microsoft_aspnetcore_hosting_http_server_request_duration_bucket{job=\"gateway\"}[1m])))", "legendFormat": "p99", "refId": "C" }
      ]
    },
    {
      "id": 5,
      "title": "Запросов/с по эндпоинтам",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus-mazy" },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "pointSize": 3,
            "showPoints": "never"
          }
        }
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "right",
          "calcs": [ "lastNotNull" ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        { "expr": "topk(10, sum by (http_request_method, http_route) (rate(microsoft_aspnetcore_hosting_http_server_request_duration_count{job=\"gateway\", http_route!=\"\"}[1m])))", "legendFormat": "{{http_request_method}} {{http_route}}", "refId": "A" }
      ]
    }
  ]
}
